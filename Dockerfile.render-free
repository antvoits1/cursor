FROM node:22-bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive \
    NODE_ENV=production \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PATH=/opt/venv/bin:$PATH

WORKDIR /app

# Render Free has 512 MB RAM. The persistent Python transport and curl_cffi fit;
# local Chromium and Camoufox do not. Keeping those browser binaries out of this
# image avoids both out-of-memory crashes and a multi-gigabyte cold start.
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-venv ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv /opt/venv \
    && pip install --upgrade pip setuptools wheel \
    && pip install "curl_cffi>=0.7.0"

COPY package.json package-lock.json ./
RUN npm ci --include=dev

COPY --chown=node:node . .
RUN npm run build \
    && mkdir -p /tmp/extractor-runtime \
    && chown -R node:node /tmp/extractor-runtime /app

USER node

ENV HOST=0.0.0.0 \
    PORT=10000 \
    EXTRACTOR_RUNTIME_DIR=/tmp/extractor-runtime

EXPOSE 10000

CMD ["npm", "start"]
