{
  "name": "extractor-react-layered",
  "private": true,
  "version": "3.0.0",
  "description": "Extractor — layered public-record business intelligence and contact enrichment platform.",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false server.ts",
    "start": "node ./scripts/start-production.mjs",
    "start:unix": "NODE_ENV=production tsx server.ts",
    "build": "vite build",
    "lint": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "verify": "npm run lint && npm run test && npm run build",
    "cf-browser:install": "npm --prefix cloudflare-browser ci",
    "cf-browser:check": "npm --prefix cloudflare-browser run check",
    "cf-browser:deploy": "npm --prefix cloudflare-browser run deploy"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "express": "^4.21.2",
    "libphonenumber-js": "^1.11.19",
    "lucide-react": "^0.469.0",
    "multer": "^2.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.9",
    "tsx": "^4.19.3",
    "typescript": "~5.7.3",
    "vite": "^6.2.0"
  }
}
